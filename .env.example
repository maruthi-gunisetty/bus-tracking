# ==============================================================================
# ANSHARY BUS TRACKER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase Free Tier Configuration (Recommended)
# Obtain these from: https://supabase.com -> Project Settings -> API
# Keep the solution within free-tier services.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key

# SECURITY NOTICE:
# Never expose the Supabase service_role secret key in frontend code.
# Only VITE_SUPABASE_ANON_KEY is public and safe to use in the browser.
# Row Level Security (RLS) policies in supabase_schema.sql protect the data.

# 2. Firebase Configuration (Optional Fallback)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
